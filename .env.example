# Required for default live mode. Rehearsal remains an explicit offline option.
# This workspace uses an existing loopback proxy in ignored .env.local.
# Never send a local proxy key to a vendor endpoint.
MODEL_BASE_URL=https://api.x.ai/v1
MODEL_NAME=
MODEL_API_KEY=

# Optional OFFICIAL BOT only. Never use a personal Discord account token.
# Only one allowlisted history page is read; no Discord writes are implemented.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=1562246478049710100
